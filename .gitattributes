# =============================================================================
# .gitattributes — Terraform Module
# =============================================================================

# All Terraform files: LF line endings
*.tf text eol=lf
*.tfvars text eol=lf
*.tftest.hcl text eol=lf

# Lock file: use ours on merge conflict (avoid noise)
.terraform.lock.hcl merge=ours

# Language-specific diff
*.tf diff=hcl
*.tfvars diff=hcl
*.hcl diff=hcl

# Export ignore for git archive
.gitattributes export-ignore
.gitignore export-ignore
